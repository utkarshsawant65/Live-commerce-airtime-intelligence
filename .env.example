# Snowflake credentials for generator/load_to_snowflake.py.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

SNOWFLAKE_ACCOUNT=ab12345.eu-central-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
# Key-pair auth alternative (preferred for CI); if set, PASSWORD is ignored:
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8

SNOWFLAKE_ROLE=ROLE_LOADER
SNOWFLAKE_WAREHOUSE=WH_LOAD
SNOWFLAKE_DATABASE=LIVE_COMMERCE
SNOWFLAKE_SCHEMA=RAW
