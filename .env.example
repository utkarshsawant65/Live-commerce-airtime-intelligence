# Snowflake credentials for the loader, dbt and the z-test.
# Copy to .env and fill in; .env is gitignored.

SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
# Key-pair auth instead of a password (used if set):
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=only_if_the_key_is_encrypted

SNOWFLAKE_ROLE=ROLE_LOADER
SNOWFLAKE_WAREHOUSE=WH_LOAD
SNOWFLAKE_DATABASE=LIVE_COMMERCE
SNOWFLAKE_SCHEMA=RAW

# Read-only role/warehouse for analysis/conversion_lift_test.py --from-snowflake:
# SNOWFLAKE_BI_ROLE=ROLE_BI_READER
# SNOWFLAKE_BI_WAREHOUSE=WH_BI
